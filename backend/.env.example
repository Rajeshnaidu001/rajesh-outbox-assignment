# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# --- Database (matches docker-compose.yml — host port 5433 to dodge local Postgres clashes) ---
DATABASE_URL="postgresql://outbox:outbox@localhost:5433/outbox?schema=public"

# --- Redis (matches docker-compose.yml — host port 6380 to dodge local Redis clashes) ---
REDIS_URL="redis://localhost:6380"

# --- Elasticsearch (matches docker-compose.yml) ---
ELASTICSEARCH_URL="http://localhost:9200"

# --- Auth ---
# Any long random string. Signs the app's own JWTs (issued after Google/dev login).
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Set to "true" to expose POST /api/auth/dev-login and a "Dev Login" button on the
# frontend, so the app is fully usable without registering real OAuth apps.
ENABLE_DEV_LOGIN=true

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Slack OAuth ---
# Create an app at https://api.slack.com/apps with the "incoming-webhook" scope.
# Redirect URL: http://localhost:4000/api/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI="http://localhost:4000/api/slack/oauth/callback"

# --- Bull Board admin UI (mounted at /admin/queues) ---
ADMIN_QUEUES_USER=admin
ADMIN_QUEUES_PASS=admin

# --- Worker ---
WORKER_CONCURRENCY=5
